# 3. DESIGN PROBLEM DEFINITIONS (6 Problems x 5 Marks = 30 Marks)
# ==============================================================================
def build_design_problems(h, rng):
    problems = []

    # --- Problem 1: Half-Wave Rectifier (HWR) ---
    Vm1 = 14.0 + (h % 13)
    RL1 = 1.0 + ((h >> 4) % 5) * 0.5
    Vdc1 = Vm1 / math.pi
    Vrms1 = Vm1 / 2.0
    Idc1 = Vdc1 / RL1
    problems.append({
        "id": "D1",
        "title": "Design Problem 1: Half-Wave Rectifier (HWR) Analysis",
        "circuit_type": "hwr",
        "draw_params": {"Vm": Vm1, "RL": RL1},
        "desc": f"A Half-Wave Rectifier uses an ideal diode fed by a secondary peak voltage Vm = {Vm1} V connected to load RL = {RL1} kΩ. Calculate the average DC voltage (Vdc), RMS load voltage (Vrms), and average DC load current (Idc).",
        "fields": [
            {"key": "d1_vdc",  "label": "Vdc [V]:",  "ans": Vdc1},
            {"key": "d1_vrms", "label": "Vrms [V]:", "ans": Vrms1},
            {"key": "d1_idc",  "label": "Idc [mA]:", "ans": Idc1}
        ]
    })

    # --- Problem 2: Center-Tapped Full-Wave Rectifier (CT-FWR) ---
    Vm2 = 16.0 + ((h >> 8) % 15)
    RL2 = 1.0 + ((h >> 12) % 4)
    Vdc2 = (2.0 * Vm2) / math.pi
    PIV2 = 2.0 * Vm2
    Idc2 = Vdc2 / RL2
    problems.append({
        "id": "D2",
        "title": "Design Problem 2: Center-Tapped Full-Wave Rectifier (CT-FWR)",
        "circuit_type": "ctfwr",
        "draw_params": {"Vm": Vm2, "RL": RL2},
        "desc": f"Each half of a center-tapped transformer secondary produces peak voltage Vm = {Vm2} V across load RL = {RL2} kΩ. Determine the DC output voltage (Vdc), DC load current (Idc), and minimum PIV rating required for each diode.",
        "fields": [
            {"key": "d2_vdc", "label": "Vdc [V]:",  "ans": Vdc2},
            {"key": "d2_idc", "label": "Idc [mA]:", "ans": Idc2},
            {"key": "d2_piv", "label": "PIV [V]:",  "ans": PIV2}
        ]
    })

    # --- Problem 3: Full-Wave Bridge Rectifier (BR) ---
    Vm3 = 18.0 + ((h >> 16) % 15)
    RL3 = 2.0 + ((h >> 20) % 4)
    Vdc3 = (2.0 * Vm3) / math.pi
    Vrms3 = Vm3 / math.sqrt(2.0)
    Pdc3 = (Vdc3 ** 2) / RL3
    problems.append({
        "id": "D3",
        "title": "Design Problem 3: Full-Wave Bridge Rectifier (BR) Performance",
        "circuit_type": "bridge",
        "draw_params": {"Vm": Vm3, "RL": RL3},
        "desc": f"A 4-diode Full-Wave Bridge Rectifier is supplied with peak AC voltage Vm = {Vm3} V (50 Hz) across RL = {RL3} kΩ. Calculate the average DC output voltage (Vdc), RMS output voltage (Vrms), and DC power delivered to the load (Pdc in mW).",
        "fields": [
            {"key": "d3_vdc",  "label": "Vdc [V]:",  "ans": Vdc3},
            {"key": "d3_vrms", "label": "Vrms [V]:", "ans": Vrms3},
            {"key": "d3_pdc",  "label": "Pdc [mW]:", "ans": Pdc3}
        ]
    })

    # --- Problem 4: Full-Wave Bridge Rectifier with Shunt Capacitor Filter ---
    Vm4 = 20.0 + ((h >> 24) % 11)
    f4 = 50.0
    RL4_ohm = 500 + ((h >> 28) % 6) * 100
    C4_uF = 100 + ((h >> 32) % 5) * 50
    C4_F = C4_uF * 1e-6
    gamma4 = 1.0 / (4.0 * math.sqrt(3.0) * f4 * RL4_ohm * C4_F)
    Vdc4 = Vm4 / (1.0 + (1.0 / (4.0 * f4 * RL4_ohm * C4_F)))
    Vr_pp4 = Vdc4 / (2.0 * f4 * RL4_ohm * C4_F)
    problems.append({
        "id": "D4",
        "title": "Design Problem 4: Bridge Rectifier with Shunt Capacitor Filter",
        "circuit_type": "filter_analysis",
        "draw_params": {"Vm": Vm4, "C": C4_uF, "RL": RL4_ohm},
        "desc": f"A 50 Hz Full-Wave Bridge Rectifier (Vm = {Vm4} V) uses a shunt filter capacitor C = {C4_uF} μF across RL = {RL4_ohm} Ω. Compute the Ripple Factor γ = 1/(4√3·f·RL·C), filtered DC voltage Vdc = Vm/(1 + 1/(4·f·RL·C)), and peak-to-peak ripple voltage Vr(p-p) = Vdc/(2·f·RL·C).",
        "fields": [
            {"key": "d4_gam",  "label": "Ripple γ:",    "ans": gamma4},
            {"key": "d4_vdc",  "label": "Vdc [V]:",     "ans": Vdc4},
            {"key": "d4_vrpp", "label": "Vr(p-p) [V]:", "ans": Vr_pp4}
        ]
    })

    # --- Problem 5: Capacitor Filter Sizing for Target Ripple Specification ---
    Vm5 = 24.0 + ((h >> 36) % 9)
    f5 = 50.0
    RL5_ohm = 400 + ((h >> 40) % 5) * 100
    target_gamma5 = round(0.02 + ((h >> 44) % 4) * 0.01, 2)
    C5_req_F = 1.0 / (4.0 * math.sqrt(3.0) * f5 * RL5_ohm * target_gamma5)
    C5_req_uF = C5_req_F * 1e6
    Vdc5 = Vm5 / (1.0 + (1.0 / (4.0 * f5 * RL5_ohm * C5_req_F)))
    problems.append({
        "id": "D5",
        "title": "Design Problem 5: Capacitor Filter Design for Target Ripple Factor",
        "circuit_type": "filter_design",
        "draw_params": {"Vm": Vm5, "gamma": target_gamma5, "RL": RL5_ohm},
        "desc": f"Design a shunt capacitor filter for a 50 Hz Full-Wave Rectifier (Vm = {Vm5} V, RL = {RL5_ohm} Ω) to achieve a target Ripple Factor γ = {target_gamma5}. Find the required filter capacitance C (in μF) and the resulting DC output voltage Vdc = Vm/(1 + 1/(4·f·RL·C)).",
        "fields": [
            {"key": "d5_c",   "label": "Required C [μF]:",  "ans": C5_req_uF},
            {"key": "d5_vdc", "label": "Resulting Vdc [V]:", "ans": Vdc5}
        ]
    })

    # --- Problem 6: Zener Shunt Voltage Regulator Design ---
    VZ6 = float(rng.choice([6, 8, 9, 10, 12]))
    Vin6 = VZ6 + 6.0 + ((h >> 48) % 7)
    RL6_ohm = 200 + ((h >> 52) % 4) * 100
    IZ6_mA = 15.0 + ((h >> 56) % 16)
    IL6_mA = (VZ6 / RL6_ohm) * 1000.0
    IS6_mA = IZ6_mA + IL6_mA
    RS6_ohm = ((Vin6 - VZ6) / IS6_mA) * 1000.0
    PZ6_mW = VZ6 * IZ6_mA
    problems.append({
        "id": "D6",
        "title": "Design Problem 6: Zener Shunt Voltage Regulator Design",
        "circuit_type": "zener",
        "draw_params": {"Vin": Vin6, "VZ": VZ6, "IZ": IZ6_mA, "RL": RL6_ohm},
        "desc": f"Design a Zener shunt regulator to supply VL = VZ = {VZ6} V across RL = {RL6_ohm} Ω from an unregulated input Vin = {Vin6} V while maintaining Zener current IZ = {IZ6_mA} mA. Calculate Load Current IL (mA), Series Resistor RS (Ω), and Zener Power Dissipation PZ (mW).",
        "fields": [
            {"key": "d6_il", "label": "IL [mA]:", "ans": IL6_mA},
            {"key": "d6_rs", "label": "RS [Ω]:",  "ans": RS6_ohm},
            {"key": "d6_pz", "label": "PZ [mW]:", "ans": PZ6_mW}
        ]
    })

    return problems

# ==============================================================================
# 4. LAUNCH THE APPLICATION
# ==============================================================================
launch_assessment(ASSESSMENT_CONFIG, MCQ_BANK, build_design_problems)
